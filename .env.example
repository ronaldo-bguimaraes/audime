# =============================================================================
# Audime — Environment Configuration
# =============================================================================
# Copie este arquivo como `.env` e preencha os valores reais.
# NUNCA commite o `.env` — ele está no .gitignore.
# =============================================================================

# R2 Object Storage
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_STORAGE_BUCKET="storage"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# PostgreSQL
DB_POSTGRES_USER="postgres"
DB_POSTGRES_PASSWORD="postgres"
DB_POSTGRES_HOST="localhost"
DB_POSTGRES_NAME="audime"
DB_POSTGRES_PORT=5432

# Redis (ARQ task queue)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# Environment (development / production)
APP_ENV="development"

# SMTP (Gmail)
# Generate App Password at https://myaccount.google.com/apppasswords (needs 2FA)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="guimaraes.ronaldob@gmail.com"   # Gmail account that authenticates
SMTP_PASSWORD=""
MAIL_FROM="guimaraes.ronaldob@gmail.com"   # Must match SMTP_USER or be a verified alias
MAIL_FROM_NAME="Audime"

# JWT
JWT_SECRET="dev-secret-change-in-production-min-32-chars!!"

# Cloudflare Tunnel (opcional — preencher apenas em produção)
CLOUDFLARE_TUNNEL_TOKEN=""
